<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>أصحاب ولا أغراب</title>
<link href="https://fonts.googleapis.com/css2?family=Lalezar&family=Cairo:wght@500;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#fff;--fg:#1b0a14;--ac:#ff2d95;--soft:#ffe3f1;--glow:rgba(255,45,149,.55);box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#000;--fg:#fff;--ac:#ff1a3c;--soft:#2a0509;--glow:rgba(255,26,60,.6)}}
:root[data-theme="dark"]{--bg:#000;--fg:#fff;--ac:#ff1a3c;--soft:#2a0509;--glow:rgba(255,26,60,.6)}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--fg);font-family:Cairo,Tahoma,sans-serif;min-height:100vh;transition:background .3s,color .3s}
main{max-width:480px;margin:0 auto;padding:18px 18px 40px}
header{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
.logo{font-family:Lalezar,Cairo,sans-serif;font-size:30px;color:var(--ac);text-shadow:0 0 14px var(--glow);margin:0;line-height:1.1}
#theme{width:44px;height:44px;border-radius:50%;border:2px solid var(--ac);background:var(--bg);color:var(--ac);font-size:20px;cursor:pointer;box-shadow:0 0 12px var(--glow)}
h2{font-family:Lalezar,Cairo,sans-serif;font-size:26px;margin:14px 0 8px;font-weight:400}
p{line-height:1.7;margin:6px 0}
.hero{font-size:62px;text-align:center;margin:18px 0 4px;filter:drop-shadow(0 0 16px var(--glow))}
.btn{display:block;width:100%;padding:14px;margin:10px 0;border:2px solid var(--ac);border-radius:16px;background:var(--bg);color:var(--fg);font:700 17px Cairo,sans-serif;cursor:pointer;text-align:center;transition:transform .12s,box-shadow .2s}
.btn:active{transform:scale(.97)}
.btn.main{background:var(--ac);color:#fff;box-shadow:0 0 22px var(--glow)}
.btn:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid var(--fg);outline-offset:2px}
.opt.sel{background:var(--soft);box-shadow:0 0 16px var(--glow)}
.opt.ok{background:var(--ac);color:#fff}
input,textarea{width:100%;padding:13px;border:2px solid var(--ac);border-radius:14px;background:var(--bg);color:var(--fg);font:500 16px Cairo,sans-serif;margin:8px 0}
textarea{min-height:90px;direction:ltr;text-align:left;word-break:break-all}
.bar{height:8px;background:var(--soft);border-radius:8px;overflow:hidden;margin:6px 0 14px}
.bar i{display:block;height:100%;background:var(--ac);box-shadow:0 0 10px var(--glow);transition:width .3s}
.code{direction:ltr;text-align:left;word-break:break-all;background:var(--soft);padding:12px;border-radius:12px;font-size:13px;border:2px dashed var(--ac)}
.row{display:flex;align-items:center;justify-content:space-between;padding:10px 12px;border-bottom:1px solid var(--soft)}
.score{font-family:Lalezar,Cairo,sans-serif;font-size:72px;text-align:center;color:var(--ac);text-shadow:0 0 22px var(--glow);margin:0}
.erow{display:flex;gap:8px;align-items:center}.erow input{margin:5px 0}.pick{flex:none;width:44px;height:44px;border-radius:50%;border:2px solid var(--ac);background:var(--bg);color:var(--bg);font-size:20px;cursor:pointer}.pick.on{background:var(--ac);color:#fff;box-shadow:0 0 12px var(--glow)}.cnt{display:grid;grid-template-columns:1fr 1fr;gap:10px}.lk{border-radius:6px;text-align:center;letter-spacing:6px;font-size:22px;padding:16px}.shake{animation:sh .35s}@keyframes sh{25%{transform:translateX(-8px)}75%{transform:translateX(8px)}}.err{color:var(--ac);font-weight:700;min-height:22px}
.link{background:none;border:0;color:var(--ac);font:700 15px Cairo,sans-serif;cursor:pointer;padding:8px;text-decoration:underline}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<main>
<header><h1 class="logo">أصحاب ولا أغراب</h1><button id="theme" aria-label="تغيير الوضع">☾</button></header>
<div id="app"></div>
</main>
<script>
var app=document.getElementById('app'),root=document.documentElement,S={};
var AC=null;
function beep(f,d,t){try{AC=AC||new (window.AudioContext||window.webkitAudioContext)();var o=AC.createOscillator(),g=AC.createGain();o.type=t||'sine';o.frequency.value=f;g.gain.value=.08;o.connect(g);g.connect(AC.destination);o.start();g.gain.exponentialRampToValueAtTime(.001,AC.currentTime+d);o.stop(AC.currentTime+d)}catch(e){}}
var sTap=function(){beep(520,.1)},sOk=function(){beep(660,.12,'triangle');setTimeout(function(){beep(880,.18,'triangle')},110)},sNo=function(){beep(180,.25,'sawtooth')};
function enc(o){return btoa(unescape(encodeURIComponent(JSON.stringify(o))))}
function dec(s){return JSON.parse(decodeURIComponent(escape(atob(s.trim()))))}
function esc(s){var d=document.createElement('div');d.textContent=s;return d.innerHTML}
function store(k,v){try{if(v===undefined)return JSON.parse(localStorage.getItem(k)||'null');localStorage.setItem(k,JSON.stringify(v))}catch(e){return null}}
function copy(id,btn){var t=document.getElementById(id).textContent;sTap();if(navigator.clipboard)navigator.clipboard.writeText(t).then(function(){btn.textContent='اتنسخ ✓'},function(){btn.textContent='انسخه بإيدك'});else btn.textContent='انسخه بإيدك'}
function setTheme(t){root.setAttribute('data-theme',t);document.getElementById('theme').textContent=t==='dark'?'☀':'☾';store('theme',t)}
document.getElementById('theme').onclick=function(){sTap();setTheme(root.getAttribute('data-theme')==='dark'?'light':'dark')};
var st=store('theme');setTheme(st||(window.matchMedia&&matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'));

function home(){
app.innerHTML='<div class="hero">🫣</div><h2 style="text-align:center">مين فعلاً يعرفك؟</h2><p style="text-align:center">اكتب أسئلتك أنت واختار الإجابة الصح، ابعت الكود لصحابك، وشوف مين صاحب ومين غريب.</p>'+
'<button class="btn main" id="a">اعمل كويزك</button><button class="btn" id="b">عندي كود من صاحبي</button><button class="btn" id="c">شوف نتايج صحابي</button>';
a.onclick=function(){sTap();S={name:'',n:0};create()};b.onclick=function(){sTap();join()};c.onclick=function(){sTap();inbox()}}

function ask(title,qs,onPick){
var q=qs[S.i];
app.innerHTML='<p>'+title+' — '+(S.i+1)+' من '+qs.length+'</p><div class="bar"><i style="width:'+(S.i/qs.length*100)+'%"></i></div><h2>'+esc(q.t)+'</h2>'+q.o.map(function(o,k){return '<button class="btn opt" data-k="'+k+'">'+esc(o)+'</button>'}).join('');
[].forEach.call(app.querySelectorAll('.opt'),function(el){el.onclick=function(){onPick(+el.dataset.k,el)}})}

function create(){
if(!S.name){app.innerHTML='<h2>اسمك إيه؟</h2><input id="n" maxlength="20" placeholder="اكتب اسمك"><div class="err" id="e"></div><button class="btn main" id="go">التالي</button><button class="link" id="bk">رجوع</button>';
go.onclick=function(){var v=n.value.trim();if(!v){e.textContent='اكتب اسمك الأول';sNo();return}S.name=v;sOk();create()};bk.onclick=function(){S={};home()};return}
if(!S.n){app.innerHTML='<h2>عايز كام سؤال؟</h2><p>اكتب أي عدد تحبه من 1 لحد 100، وانت اللي هتكتب الأسئلة والإجابات.</p><input id="cn" type="text" inputmode="numeric" maxlength="3" placeholder="مثلاً 7"><div class="err" id="e"></div><button class="btn main" id="go">ابدأ</button><button class="link" id="bk">رجوع</button>';
go.onclick=function(){var x=parseInt(nd(cn.value),10);if(!(x>=1&&x<=100)){e.textContent='اكتب عدد من 1 لـ 100';sNo();return}S.n=x;S.qs=[];S.i=0;sOk();editor()};bk.onclick=function(){S.name='';create()};return}
editor()}

function editor(){
var i=S.i,cur=S.qs[i]||{t:'',o:[],c:-1},sel=cur.c,last=i===S.n-1;
app.innerHTML='<p>سؤالك رقم '+(i+1)+' من '+S.n+'</p><div class="bar"><i style="width:'+(i/S.n*100)+'%"></i></div><input id="t" maxlength="90" placeholder="اكتب السؤال">'+
[0,1,2,3].map(function(k){return '<div class="erow"><button class="pick'+(sel===k?' on':'')+'" data-k="'+k+'" aria-label="دي الإجابة الصح">✓</button><input class="oi" maxlength="50" placeholder="إجابة '+(k+1)+(k>1?' (اختياري)':'')+'"></div>'}).join('')+
'<p>دوس على ✓ جنب الإجابة الصح.</p><div class="err" id="e"></div><button class="btn main" id="nx">'+(last?'خلصت، جهّز الكود':'السؤال اللي بعده')+'</button><button class="link" id="bk">رجوع</button>';
t.value=cur.t;var oi=app.querySelectorAll('.oi');[].forEach.call(oi,function(el,k){el.value=cur.o[k]||''});
var pk=app.querySelectorAll('.pick');[].forEach.call(pk,function(b){b.onclick=function(){sel=+b.dataset.k;sTap();[].forEach.call(pk,function(x){x.classList.toggle('on',x===b)})}});
nx.onclick=function(){
var tt=t.value.trim(),o=[],c=-1,bad='';
[].forEach.call(oi,function(el,k){var v=el.value.trim();if(v){o.push(v);if(k===sel)c=o.length-1}});
if(!tt)bad='اكتب السؤال';else if(o.length<2)bad='اكتب إجابتين على الأقل';else if(c<0)bad='اختار الإجابة الصح بدوسة على ✓ جنب إجابة مكتوبة';
if(bad){e.textContent=bad;sNo();return}
S.qs[i]={t:tt,o:o,c:c};sTap();
if(last){S.code=enc({n:S.name,q:S.qs});sOk();share()}else{S.i++;editor()}};
bk.onclick=function(){if(i>0){S.i--;editor()}else{S.n=0;create()}}}

function share(){
app.innerHTML='<div class="hero">🎉</div><h2 style="text-align:center">كويزك جاهز يا '+esc(S.name)+'</h2><p>انسخ الكود ده وابعته لصحابك على واتساب أو أي مكان. هم هيفتحوا الموقع ويدوسوا «عندي كود من صاحبي».</p><div class="code" id="cd">'+S.code+'</div><button class="btn main" id="cp">انسخ الكود</button><button class="btn" id="hm">الرئيسية</button>';
cp.onclick=function(){copy('cd',cp)};hm.onclick=function(){S={};home()}}

function join(msg){
app.innerHTML='<h2>الصق الكود هنا</h2><textarea id="c" placeholder="الكود اللي صاحبك بعته"></textarea><div class="err" id="e">'+(msg||'')+'</div><button class="btn main" id="go">ابدأ الكويز</button><button class="link" id="bk">رجوع</button>';
bk.onclick=home;
go.onclick=function(){try{var d=dec(c.value);if(!d.n||!Array.isArray(d.q)||!d.q.length)throw 0;S={i:0,ans:[],friend:d};sOk();play()}catch(x){sNo();e.textContent='الكود ده مش شغال، اتأكد إنك نسخته كامل'}}}

function play(){
var f=S.friend;
if(S.i>=f.q.length){var sc=0;S.ans.forEach(function(a,k){if(a===f.q[k].c)sc++});S.score=sc;result();return}
ask('خمّن إجابات '+esc(f.n),f.q,function(k,el){
var right=f.q[S.i].c,hit=k===right;S.ans.push(k);hit?sOk():sNo();
[].forEach.call(app.querySelectorAll('.opt'),function(b){b.onclick=null;if(+b.dataset.k===right)b.classList.add('ok')});
if(!hit)el.style.opacity='.45';
setTimeout(function(){S.i++;play()},900)})}

function result(){
var f=S.friend,sc=S.score,n=f.q.length,r=sc/n,v=r>=.8?['صاحب بجد 🔥','انت فعلاً عارفه كويس']:r>=.4?['نص صاحب 😅','تعرفه شوية بس لسه قدامك']:['غريب 🥶','الصراحة ما تعرفوش خالص'];
app.innerHTML='<h2 style="text-align:center">انت بالنسبة لـ'+esc(f.n)+'</h2><p class="score">'+sc+'/'+n+'</p><h2 style="text-align:center">'+v[0]+'</h2><p style="text-align:center">'+v[1]+'</p><p>عشان '+esc(f.n)+' يشوف نتيجتك، اكتب اسمك وابعتله الكود ده:</p><input id="me" maxlength="20" placeholder="اسمك"><div class="code" id="cd"></div><button class="btn main" id="cp">انسخ كود النتيجة</button><button class="btn" id="hm">الرئيسية</button>';
var upd=function(){document.getElementById('cd').textContent=enc({f:f.n,w:me.value.trim()||'مجهول',s:sc,t:n})};upd();me.oninput=upd;
cp.onclick=function(){copy('cd',cp)};hm.onclick=function(){S={};home()}}

function inbox(msg){
var list=store('results')||[];
var rows=list.length?list.slice().sort(function(a,b){return b.s-a.s}).map(function(r){return '<div class="row"><b>'+esc(r.w)+'</b><span>'+r.s+'/'+r.t+' '+(r.s/r.t>=.8?'🔥':r.s/r.t>=.4?'😅':'🥶')+'</span></div>'}).join(''):'<p>لسه مفيش نتايج. ابعت كودك لصحابك وخليهم يبعتولك كود نتيجتهم.</p>';
app.innerHTML='<h2>نتايج صحابك</h2>'+rows+'<h2>ضيف نتيجة</h2><textarea id="c" placeholder="الصق كود نتيجة من صاحبك"></textarea><div class="err" id="e">'+(msg||'')+'</div><button class="btn main" id="add">ضيف</button><button class="link" id="bk">رجوع</button>';
bk.onclick=home;
add.onclick=function(){try{var d=dec(c.value);if(!d.w||typeof d.s!=='number')throw 0;list.push({w:d.w,s:d.s,t:d.t});store('results',list);sOk();inbox()}catch(x){sNo();e.textContent='كود النتيجة مش صح'}}}
function nd(t){return t.replace(/[٠-٩]/g,function(c){return c.charCodeAt(0)-1632})}
function okPw(v){var p=nd(v).split(/[^0-9]+/).filter(Boolean).map(Number);return p.length===3&&p[0]===9&&p[1]===9&&p[2]===2008}
function gate(){
app.innerHTML='<div class="hero">🔒</div><h2 id="gt" style="text-align:center">اكتب الباسورد</h2><input id="pw" class="lk" type="password" autocomplete="off" dir="ltr" aria-label="الباسورد"><div class="err" id="e" style="text-align:center"></div><button class="btn main" id="go">دخول</button>';
var n=0,d=1,iv=setInterval(function(){if(pw.value){pw.placeholder='';return}pw.placeholder='*'.repeat(n);n+=d;if(n>=9)d=-1;if(n<=0)d=1},200);
function chk(){if(okPw(pw.value)){clearInterval(iv);sOk();home();return}
sNo();pw.value='';gt.textContent='اكتب كلمة السر';e.textContent='انت غريب 🥶 — نص صاحب؟ افتكر قبل ما تبقى غريب';pw.classList.remove('shake');void pw.offsetWidth;pw.classList.add('shake')}
go.onclick=chk;pw.onkeydown=function(ev){if(ev.key==='Enter')chk()};pw.focus()}
gate();
</script>
</body>
</html>
